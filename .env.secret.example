# Образец файла .env.secret. Скопируйте рядом под именем `.env.secret`
# и подставьте значения. Сам .env.secret в git не попадает.
#
# Здесь лежат два разных секрета, и путать их не стоит.


# 1. Ключ проекта — обязателен.
#
# Открывает всё ВНУТРИ базы: таблицы, пользователей, отправку писем. Обходит
# все политики RLS. Его читают скрипты из scripts/ и бот.
#
# Где взять: Project Settings → API Keys → Secret keys → «newkey».
SUPABASE_SECRET_KEY=sb_secret_...


# 2. Токен аккаунта — необязателен.
#
# Ключ выше до настроек проекта не достаёт: Site URL, список редиректов,
# включённые провайдеры живут снаружи базы, и ими управляет Management API.
# Ему нужен токен аккаунта.
#
# Разница важнее, чем кажется: ключ проекта — это один проект, токен — весь
# аккаунт со всеми проектами. Поэтому он и необязателен. Без него скрипты
# продолжают работать: `npm run auth:url` проверит, что настроено, и
# напечатает, что нажать в панели руками. С ним та же команда с `-- --apply`
# сделает это сама.
#
# Где взять: правый верхний угол панели → Account Preferences → Access
# Tokens → Generate new token.
# SUPABASE_ACCESS_TOKEN=sbp_...
