# Скопируйте в .env и подставьте значения из Supabase → Project Settings → API
# Префикс EXPO_PUBLIC_ обязателен: без него Expo не прокинет переменную в бандл.
#
# anon-ключ публичный по замыслу — он попадает и в APK, и в JS веб-версии.
# Данные защищает не он, а RLS-политики из supabase/migrations/20260816120200_rls.sql.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Город пилота. Обязан совпадать с дефолтом items.city в базе:
# каталог фильтруется по нему, и расхождение даст пустую витрину.
EXPO_PUBLIC_PILOT_CITY=kokshetau

# Способ входа: invite или sms.
# Пока SMS-провайдер не подключён — invite. Показывать «Получить код»
# первым в этом случае значит подсунуть кнопку, которая отвечает ошибкой
# про неподключённого провайдера, и человек решит, что сломано приложение.
EXPO_PUBLIC_AUTH_MODE=invite
