# Скопируйте в bot/.env и заполните. Файл в .gitignore — репозиторий публичный.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AA...

# Адрес проекта Supabase — тот же, что в корневом .env
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Секретный ключ (Project Settings → API Keys → Secret keys).
#
# Он обходит все политики RLS, и именно поэтому бот запускается на машине,
# которую вы контролируете, а не на чужом хостинге «за две минуты». Ключ
# нужен боту по существу: он пишет telegram_id в чужие строки и отмечает
# доставленные уведомления — обе операции невозможны от имени пользователя.
SUPABASE_SECRET_KEY=sb_secret_...

# Как часто спрашивать базу о новых уведомлениях, секунды.
# 15 секунд — компромисс: человек воспринимает это как «сразу», а нагрузка
# остаётся четыре запроса в минуту.
POLL_SECONDS=15
