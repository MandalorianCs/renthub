// Настройка knip (github.com/webpro-nl/knip) — поиска мёртвого кода:
// файлов, которые никто не импортирует, экспортов, которые никто не
// читает, и зависимостей, объявленных мимо package.json.
//
//   npx knip
//
// Польза уже подтверждена: knip нашёл, что app.json объявляет
// userInterfaceStyle, а исполняющего пакета expo-system-ui в
// зависимостях нет — свойство молча ничего не делало. Он же показал
// заготовку размеров шрифта в теме, о которой знал только комментарий.
//
// Ниже перечислено то, что knip считает мёртвым, а мы — живым, и каждый
// пункт с причиной. Список короткий намеренно: длинный список исключений
// превращает проверку в декорацию.
{
  // Точки входа. Экраны приложения запускает expo-router по файловой
  // структуре, скрипты — npm, edge-функции — HTTP-запрос Supabase:
  // ни на что из этого нет импорта в коде, и без этого списка knip
  // считает мёртвым весь проект.
  "entry": [
    "app/**/*.{ts,tsx}",
    "scripts/*.mjs",
    "scripts/*.py",
    "supabase/functions/**/index.ts"
  ],

  "project": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}", "scripts/*.mjs"],

  // Списка ignore здесь нет намеренно: knip сам сказал, что db-tests,
  // docs и dist в него не попадают — стенд живёт на своём package.json,
  // а docs и dist собираются. Исключение, которое ничего не исключает,
  // со временем начинает объяснять не то.

  // eas ставится глобально: это командная строка сервиса сборки, а не
  // зависимость приложения.
  "ignoreBinaries": ["eas"],

  // Экспорт, который читают внутри того же файла, мёртвым не считается:
  // itemUrl в share.ts экспортирован ради ясности имени, а не ради
  // импорта снаружи.
  "ignoreExportsUsedInFile": true
}
