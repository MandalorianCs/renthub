# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Собранная публикация для GitHub Pages.
#
# Папка производная: её создаёт `npm run build:pages` из исходников. В
# репозитории она лежала вынужденно — пока в настройках стоял Source =
# «Deploy from a branch → /docs», GitHub брал сайт прямо из ветки.
#
# 05.09.2026 источник переключён на «GitHub Actions», и условие отпало.
# Сайт публикует только наш workflow: он делает checkout, собирает и
# отдаёт результат напрямую, в ветку не заглядывая.
#
# Вместе с папкой ушли два правила, которые приходилось помнить:
# «пересобери docs тем же коммитом» и «на адресе может оказаться не то,
# что в main». Забыть больше нечего — забывать стало не о чем.
#
# История тоже перестала толстеть: каждая пересборка добавляла в неё
# бандл на 2 МБ, хотя это производное от исходников, а не исходник.
docs/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Секретный ключ Supabase лежит отдельно от .env намеренно: .env читает
# сборка Expo и вшивает EXPO_PUBLIC_-переменные в бандл, а этот файл
# читают только скрипты из scripts/.
.env.secret

# Ключи бота: тот же секретный ключ Supabase плюс токен Telegram.
bot/.env
bot/__pycache__/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Фото для демонстрационных объявлений — весят много, репозиторию не нужны.
# Инструкция в demo-photos/README.md остаётся.
demo-photos/*
!demo-photos/README.md
bot/.env.backup

# Служебное состояние Supabase CLI (привязка проекта).
supabase/.temp/
