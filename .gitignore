# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Собранная публикация для GitHub Pages.
# Expo именует ассеты по их исходному пути, поэтому шрифты ложатся в
# docs/app/assets/node_modules/… — и правило выше молча выбрасывало их
# из коммита. Симптом: приложение открывается белым экраном, потому что
# оно ждёт шрифты перед первым кадром, а те возвращают 404.
#
# Порядок важен: сначала возвращаем саму папку, потом содержимое. Git не
# переподключает файл, если исключена его родительская директория.
!docs/
!docs/**

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Секретный ключ Supabase лежит отдельно от .env намеренно: .env читает
# сборка Expo и вшивает EXPO_PUBLIC_-переменные в бандл, а этот файл
# читают только скрипты из scripts/.
.env.secret

# Ключи бота: тот же секретный ключ Supabase плюс токен Telegram.
bot/.env
bot/__pycache__/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Фото для демонстрационных объявлений — весят много, репозиторию не нужны.
# Инструкция в demo-photos/README.md остаётся.
demo-photos/*
!demo-photos/README.md
