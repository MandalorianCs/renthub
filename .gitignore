# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Собранная публикация для GitHub Pages — производное, не исходник.
#
# Раньше папка лежала в репозитории, и правило node_modules/ выше молча
# выбрасывало из коммита шрифты (Expo именует ассеты по исходному пути,
# поэтому они ложатся в docs/app/assets/node_modules/…). Приходилось
# возвращать её исключениями !docs/ и !docs/**.
#
# Теперь публикацию собирает GitHub Actions и отдаёт артефактом, а не
# берёт из ветки. Проверено 01.09.2026: опубликованный бандл отличался от
# лежавшего в docs/ репозитория — то есть содержимое папки на сайт не
# влияло уже давно и только вводило в заблуждение, показывая старую
# сборку рядом со свежим кодом.
#
# Держать её здесь дорого и без пользы: каждая пересборка добавляла в
# историю бандл на 2 МБ.
docs/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Секретный ключ Supabase лежит отдельно от .env намеренно: .env читает
# сборка Expo и вшивает EXPO_PUBLIC_-переменные в бандл, а этот файл
# читают только скрипты из scripts/.
.env.secret

# Ключи бота: тот же секретный ключ Supabase плюс токен Telegram.
bot/.env
bot/__pycache__/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Фото для демонстрационных объявлений — весят много, репозиторию не нужны.
# Инструкция в demo-photos/README.md остаётся.
demo-photos/*
!demo-photos/README.md
bot/.env.backup

# Служебное состояние Supabase CLI (привязка проекта).
supabase/.temp/
