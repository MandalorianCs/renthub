# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Собранная публикация для GitHub Pages.
#
# Папка производная, и держать её в репозитории не хочется: каждая
# пересборка добавляет в историю бандл на 2 МБ. Но пока в настройках
# репозитория стоит Source = «Deploy from a branch → /docs», GitHub при
# каждом пуше лезет за ней в ветку и без неё падает на шаге
# «Build with Jekyll» — красным, на каждом пуше.
#
# Поэтому папка здесь. Убрать её насовсем можно ровно после того, как в
# Settings → Pages переключат Source на «GitHub Actions»: тогда сайт
# публикует только наш workflow, и брать из ветки нечего.
#
# Порядок правил важен: сначала возвращаем саму папку, потом содержимое.
# Git не переподключает файл, если исключена его родительская директория,
# а исключает её правило node_modules/ выше — Expo именует ассеты по
# исходному пути, и шрифты ложатся в docs/app/assets/node_modules/…
!docs/
!docs/**

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Секретный ключ Supabase лежит отдельно от .env намеренно: .env читает
# сборка Expo и вшивает EXPO_PUBLIC_-переменные в бандл, а этот файл
# читают только скрипты из scripts/.
.env.secret

# Ключи бота: тот же секретный ключ Supabase плюс токен Telegram.
bot/.env
bot/__pycache__/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Фото для демонстрационных объявлений — весят много, репозиторию не нужны.
# Инструкция в demo-photos/README.md остаётся.
demo-photos/*
!demo-photos/README.md
bot/.env.backup

# Служебное состояние Supabase CLI (привязка проекта).
supabase/.temp/
